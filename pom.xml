<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>pt.ua.deti.tqs</groupId>
  <artifactId>telemetry-simulator</artifactId>
  <version>1.0.0</version>
  <name>telemetry-simulator</name>
  <description>Fleet telemetry simulator that publishes over MQTT following the contract in contract/</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jacoco.version>0.8.16</jacoco.version>
    <pitest.version>1.30.2</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <hivemq-mqtt-client.version>1.4.2</hivemq-mqtt-client.version>
    <json-schema-validator.version>3.0.9</json-schema-validator.version>
    <spotless.version>3.11.0</spotless.version>
    <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <!-- Set when the repository is imported in SonarCloud; the CI skips the analysis until SONAR_TOKEN exists. -->
    <sonar.organization>o-reis</sonar.organization>
    <sonar.projectKey>o-reis_tqs-telemetry-simulator</sonar.projectKey>
    <!-- JUnit tags Surefire runs or skips; the contract profile swaps them. -->
    <tests.groups></tests.groups>
    <tests.excludedGroups>contract</tests.excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- JSON of the contract messages (Jackson 3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- MQTT client with automatic reconnect. -->
    <dependency>
      <groupId>com.hivemq</groupId>
      <artifactId>hivemq-mqtt-client</artifactId>
      <version>${hivemq-mqtt-client.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Checks built messages against the JSON Schemas in contract/schemas. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Real MQTT broker (Mosquitto) in integration tests (*IT). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Contract tests (@Tag("contract")) are left out of the default unit test run; the contract
           profile runs only them: ./mvnw test -Pcontract -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>${tests.groups}</groups>
          <excludedGroups>${tests.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>

      <!-- Unit tests (*Test) run in Surefire; integration tests (*IT) run apart, in Failsafe. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Unit and integration tests write to the same execution data, so one report covers both. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <!-- Every package below the root; the root holds only the Spring Boot entry point. -->
                    <include>pt.ua.deti.tqs.p11.simulator.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Google Java Style. `./mvnw spotless:apply` fixes, verify only checks. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Mutation testing is slow: it runs on request (-Pmutation) and on pull requests. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <!-- The MQTT publisher and its wiring, aswell as Scenario Configuration, are covered by integration tests, which PIT skips. -->
          <targetClasses>
            <param>pt.ua.deti.tqs.p11.simulator.telemetry.*</param>
            <param>pt.ua.deti.tqs.p11.simulator.contract.*</param>
            <param>pt.ua.deti.tqs.p11.simulator.config.*</param>
            <param>pt.ua.deti.tqs.p11.simulator.mqtt.MqttClientFactory</param>
          </targetClasses>
          <excludedClasses>
            <param>pt.ua.deti.tqs.p11.simulator.SimulatorApplication</param>
            <param>pt.ua.deti.tqs.p11.simulator.config.ScenarioConfiguration</param>
          </excludedClasses>
          <targetTests>
            <param>pt.ua.deti.tqs.p11.simulator.*</param>
          </targetTests>
          <excludedTestClasses>
            <param>*IT</param>
          </excludedTestClasses>
          <mutationThreshold>80</mutationThreshold>
          <failWhenNoMutations>false</failWhenNoMutations>
          <timestampedReports>false</timestampedReports>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Only the contract tests: every emitted message must follow contract/schemas. -->
    <profile>
      <id>contract</id>
      <properties>
        <tests.groups>contract</tests.groups>
        <tests.excludedGroups></tests.excludedGroups>
      </properties>
    </profile>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>mutation-gate</id>
                <phase>verify</phase>
                <goals>
                  <goal>mutationCoverage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
