{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet-telemetry-contract.example/v1/telemetry.schema.json",
  "title": "Telemetry message",
  "description": "Current state of one vehicle. Each message replaces the previous one.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "telemetry" },
        "data": {
          "type": "object",
          "required": ["batteryPercent", "lockState", "position", "hubId", "faultCode"],
          "properties": {
            "batteryPercent": { "type": "number", "minimum": 0, "maximum": 100 },
            "lockState": { "type": "string", "enum": ["locked", "unlocked"] },
            "position": {
              "description": "WGS84 position, or null if unknown.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["lat", "lon"],
                  "properties": {
                    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                    "lon": { "type": "number", "minimum": -180, "maximum": 180 }
                  }
                }
              ]
            },
            "hubId": {
              "description": "Hub where the vehicle is parked, or null if it is not in a hub.",
              "oneOf": [
                { "type": "null" },
                { "$ref": "envelope.schema.json#/$defs/identifier" }
              ]
            },
            "faultCode": {
              "description": "Current active fault, or null if none.",
              "oneOf": [
                { "type": "null" },
                { "$ref": "envelope.schema.json#/$defs/code" }
              ]
            },
            "speedKmh": { "type": "number", "minimum": 0 }
          },
          "anyOf": [
            { "properties": { "position": { "type": "object" } } },
            { "properties": { "hubId": { "type": "string" } } }
          ]
        }
      }
    }
  ]
}
